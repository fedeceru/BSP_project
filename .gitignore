# ============================================================================
# Project Specific Exclusions (BSP_project)
# ============================================================================
# Escludiamo i file raw del database PhysioNet (molto pesanti e scaricabili via WFDB)
# Vengono scaricati file con estensione .dat, .hea, .atr, .qrs, .xy
data/*
!data/.gitkeep

# Escludiamo eventuali download finiti per sbaglio nella root
*.dat
*.hea
*.atr
*.qrs

# Escludiamo i risultati (grafici generati, csv pesanti, modelli temporanei)
# Se vuoi versionare dei report specifici, rimuovi queste righe o forza l'add
results/*
!results/.gitkeep

# File temporanei
*.tmp
*.temp
scratch/

