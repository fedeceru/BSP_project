# ============================================================================
# Project Specific Exclusions (BSP_project)
# ============================================================================
# Exclude the raw PhysioNet database files (very large and downloadable via WFDB)
# Files downloaded have the extensions .dat, .hea, .atr, .qrs, .xy
data/*
!data/.gitkeep

# Exclude any downloads that accidentally ended up in the root
*.dat
*.hea
*.atr
*.qrs

# Exclude results (generated plots, heavy csv files, temporary models)
# If you want to version specific reports, remove these lines or force the add
results/*
!results/.gitkeep

# Temporary files
*.tmp
*.temp
scratch/

